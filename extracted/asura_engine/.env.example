GEMINI_API_KEY=put_your_key_in_github_secret_not_here
# Keep the selected model ID in GitHub Secret STORY_MODEL, or set it locally.
STORY_MODEL=gemini-3.7-flash
# Comma-separated fallbacks; availability depends on your Google AI Studio project/tier.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
MAX_RETRIES_PER_MODEL=2
BASE_RETRY_SECONDS=3
MAX_RETRY_SECONDS=30
